{
  "name": "dianxiu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "python3 -m http.server 3000 --bind 127.0.0.1 --directory out",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/core.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/*.ts\" scripts/*.mjs playwright.config.ts"
  },
  "dependencies": {
    "fast-png": "^6.4.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.16.0 <23"
  }
}
